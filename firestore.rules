rules_version = '2';

// ============================================================================
// Constitution Quest — Firestore Security Rules
// ============================================================================
// Role-based access control using a userProfiles collection.
//
// Each Firebase-authenticated user has a document at:
//   userProfiles/{firebaseUid}
// containing: { role, collegeId, collegeCode, userId, name, email }
//
// Access levels:
//   ADMIN     — Full access to everything (main admin only)
//   SUB_ADMIN — Access to their assigned college's data only
//   MENTOR    — Read access to student data in their college
//   STUDENT   — Read/write their own data only
//   GUEST     — External users (visitors, observers, external learners).
//              Same access as STUDENT (own data, college-wide reads) but they
//              are filtered out of leaderboards server-side.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========

    // Check if user is authenticated AND has a profile document
    function hasProfile() {
      return request.auth != null
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid));
    }

    // Get the user's role from their profile
    function role() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role;
    }

    // Get the user's collegeId from their profile
    function collegeId() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.collegeId;
    }

    // Get the user's internal DB userId from their profile
    function dbUserId() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.userId;
    }

    // Role check helpers
    function isMainAdmin()  { return hasProfile() && role() == 'ADMIN'; }
    function isSubAdmin()   { return hasProfile() && role() == 'SUB_ADMIN'; }
    function isMentor()     { return hasProfile() && role() == 'MENTOR'; }
    function isStudent()    { return hasProfile() && role() == 'STUDENT'; }
    function isGuest()      { return hasProfile() && role() == 'GUEST'; }
    function isAdmin()      { return isMainAdmin() || isSubAdmin(); }
    function isAdminOrMentor() { return isAdmin() || isMentor(); }
    // Students AND guests get the same learner-level access: own data, plus
    // college-wide reads (leaderboard, activity feed for college, etc.).
    function isLearner()    { return isStudent() || isGuest(); }

    // ========== 1. USER PROFILES ==========
    // This collection stores each user's role, collegeId, and internal userId.
    // It's used by all other rules to determine access.
    //
    // Any authenticated user can CREATE their own profile (first-time setup after login).
    // Users can READ their own profile. Admins and mentors can READ all profiles.
    // Users can UPDATE their own profile. Main admin can UPDATE any.
    match /userProfiles/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (
        request.auth.uid == uid || (hasProfile() && isAdminOrMentor())
      );
      allow update: if request.auth != null && (
        request.auth.uid == uid || isMainAdmin()
      );
      allow delete: if isMainAdmin();
    }

    // ========== 2. LEADERBOARD ==========
    // All authenticated users can READ the leaderboard (it's a public ranking).
    // Users can WRITE only their own entry (matched by internal userId).
    // Admins/mentors can delete any entry (for cleanup when an account is removed).
    // A user can also delete their own entry (self-cleanup on account deletion).
    match /leaderboard/{userId} {
      allow read: if hasProfile();
      allow create, update: if hasProfile() && (
        userId == dbUserId() || isMainAdmin()
      );
      allow delete: if hasProfile() && (
        userId == dbUserId() || isAdminOrMentor()
      );
    }

    // ========== 3. ACTIVITY FEED ==========
    // Main admin: can read ALL activities.
    // Sub-admin: can read activities from their college only.
    // Mentor: can read activities from their college only.
    // Student/Guest: can read their OWN activities only.
    // Any authenticated user can CREATE an activity (their own).
    // Admins can UPDATE activities. Admins, mentors, and the entry owner
    // can DELETE (so a user's activity feed is cleaned up when their account
    // is removed by an admin/mentor OR self-deleted).
    match /activityFeed/{activityId} {
      allow read: if hasProfile() && (
        isMainAdmin() ||
        (isAdminOrMentor() && resource.data.collegeId == collegeId()) ||
        (isLearner() && resource.data.userId == dbUserId())
      );
      allow create: if hasProfile();
      allow update: if isAdmin();
      allow delete: if hasProfile() && (
        resource.data.userId == dbUserId() || isAdminOrMentor()
      );
    }

    // ========== 4. DISCUSSION FORUM ==========
    // All authenticated users can READ topics and posts.
    // Any authenticated user can CREATE topics and posts.
    // Users can UPDATE/DELETE their own topics/posts. Admins can delete any.
    match /forum_topics/{topicId} {
      allow read: if hasProfile();
      allow create: if hasProfile();
      allow update, delete: if hasProfile() && (
        resource.data.authorId == dbUserId() || isAdmin()
      );

      // Posts (replies) within topics
      match /posts/{postId} {
        allow read: if hasProfile();
        allow create: if hasProfile();
        allow update, delete: if hasProfile() && (
          resource.data.authorId == dbUserId() || isAdmin()
        );
      }
    }

    // ========== 5. STUDENT NOTES & BOOKMARKS ==========
    // Only the owner can READ, CREATE, or UPDATE their notes.
    // Admins/mentors can DELETE notes (for cleanup when an account is removed).
    // The owner can also DELETE their own notes (self-cleanup on account deletion).
    // The path is: notes/{userId}/items/{noteId}
    // userId here is the internal DB userId (not Firebase UID).
    // Applies to both STUDENT and GUEST users.
    match /notes/{userId}/items/{noteId} {
      allow read, create, update: if hasProfile() && userId == dbUserId();
      allow delete: if hasProfile() && (
        userId == dbUserId() || isAdminOrMentor()
      );
    }

    // ========== 6. ANNOUNCEMENTS ==========
    // All authenticated users can READ announcements.
    // Only admins (main + sub) can CREATE, UPDATE, or DELETE announcements.
    // Sub-admins can only manage announcements for their own college
    // (enforced by checking targetCollegeId in the document).
    match /announcements/{announcementId} {
      allow read: if hasProfile();
      allow create: if isAdmin() && (
        isMainAdmin() ||
        (isSubAdmin() && request.resource.data.targetCollegeId == collegeId())
      );
      allow update, delete: if isAdmin() && (
        isMainAdmin() ||
        (isSubAdmin() && resource.data.targetCollegeId == collegeId())
      );
    }

    // ========== 7. LIVE MOCK TEST RANKINGS ==========
    // All authenticated users can READ rankings (to see who's taking the test).
    // Users can WRITE only their own ranking entry.
    // Admins can write any. Admins, mentors, and the entry owner can delete
    // (for cleanup when an account is removed).
    match /mockRankings/{rankingId} {
      allow read: if hasProfile();
      allow create, update: if hasProfile() && (
        request.resource.data.userId == dbUserId() || isAdmin()
      );
      allow delete: if hasProfile() && (
        resource.data.userId == dbUserId() || isAdminOrMentor()
      );
    }

    // ========== 8. CHAT MESSAGES ==========
    // Real-time chat messages, organized as:
    //   chats/{chatId}/messages/{messageId}
    //
    // chatId encodes the scope:
    //   "global"                     — global chat (all colleges)
    //   "college:{collegeId}"        — college-wide chat
    //   "dept:{departmentId}"        — department chat (students + mentor)
    //   "dept-students:{departmentId}" — students-only department chat (NO mentor/admin)
    //   "mentor:{collegeId}"         — mentors-only chat for a college
    //   "dm:{userIdA}_{userIdB}"     — private 1:1 direct message
    //                                    (userIds sorted alphabetically; both users
    //                                     must be in the same department)
    //
    // Visibility is additionally gated by Setting rows (chatvis:*) checked
    // server-side via /api/chat/config. The Firestore rules here enforce
    // structural access: a student can't read a mentor chat, a user in
    // college A can't read college B's chat, etc.
    //
    // Any authenticated user can CREATE a message IF the chatId matches their
    // scope (checked via helper functions). Anyone who can read can also
    // delete their own messages. Admins can delete any.
    match /chats/{chatId}/messages/{messageId} {
      // Read: user must be in scope for this chat type.
      allow read: if hasProfile() && canAccessChat(chatId);

      // Create: user must be in scope, and the message must include their
      // own userId (no impersonation).
      allow create: if hasProfile()
        && canAccessChat(chatId)
        && request.resource.data.userId == dbUserId();

      // Update: not allowed (messages are immutable). Delete own or admin.
      allow update: if false;
      allow delete: if hasProfile() && (
        resource.data.userId == dbUserId() || isAdmin()
      );
    }

    // Helper: get the current user's profile document data.
    function myProfile() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data;
    }

    // Helper: can the current user access a given chatId?
    // Guests have NO chat access — they're external visitors with no college
    // connection. The chat-config API returns an empty chats array for them,
    // and the StudentApp hides the Chat nav item for guests. This rule is
    // defense-in-depth.
    function canAccessChat(chatId) {
      return !isGuest()
        && (isMainAdmin()
        || (chatId == "global" && hasProfile())
        || (chatId.matches("^college:.*") && chatId == "college:" + collegeId())
        // dept chat: students + mentor + admins in the same department
        // (guests excluded — they have no departmentId)
        || (chatId.matches("^dept:.*")
            && hasProfile()
            && myProfile().departmentId != null
            && chatId == "dept:" + myProfile().departmentId)
        // dept-students chat: STUDENTS ONLY (same department, no mentor/admin/guest)
        || (chatId.matches("^dept-students:.*")
            && isStudent()
            && myProfile().departmentId != null
            && chatId == "dept-students:" + myProfile().departmentId)
        // mentor chat: mentors only, same college
        || (chatId.matches("^mentor:.*") && isMentor() && chatId == "mentor:" + collegeId())
        // dm: private 1:1 — the chatId must contain the current user's userId,
        // AND both participants must be in the same department.
        || (chatId.matches("^dm:.*")
            && hasProfile()
            && chatId.matches(".*" + dbUserId() + ".*")
            && canAccessDm(chatId))
        || (isAdmin() && chatId.matches("^college:.*")));
    }

    // Helper for DM access: both users must be in the same department.
    // chatId format: "dm:{userIdA}_{userIdB}" (sorted alphabetically).
    // We check that the current user is one of the two participants AND that
    // both participants share the same department (verified server-side via
    // userProfiles). For simplicity, we only verify the current user is a
    // participant here; the department constraint is enforced by the config
    // endpoint only returning same-department users for DMs.
    function canAccessDm(chatId) {
      return hasProfile()
        && chatId.matches(".*" + dbUserId() + ".*");
    }

    // ========== DEFAULT DENY ==========
    // Any collection not explicitly matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
