rules_version = '2';

// ============================================================================
// Constitution Quest — Firestore Security Rules
// ============================================================================
// Role-based access control using a userProfiles collection.
//
// Each Firebase-authenticated user has a document at:
//   userProfiles/{firebaseUid}
// containing: { role, collegeId, collegeCode, userId, name, email }
//
// Access levels:
//   ADMIN     — Full access to everything (main admin only)
//   SUB_ADMIN — Access to their assigned college's data only
//   MENTOR    — Read access to student data in their college
//   STUDENT   — Read/write their own data only
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========

    // Check if user is authenticated AND has a profile document
    function hasProfile() {
      return request.auth != null
        && exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid));
    }

    // Get the user's role from their profile
    function role() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role;
    }

    // Get the user's collegeId from their profile
    function collegeId() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.collegeId;
    }

    // Get the user's internal DB userId from their profile
    function dbUserId() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.userId;
    }

    // Role check helpers
    function isMainAdmin()  { return hasProfile() && role() == 'ADMIN'; }
    function isSubAdmin()   { return hasProfile() && role() == 'SUB_ADMIN'; }
    function isMentor()     { return hasProfile() && role() == 'MENTOR'; }
    function isStudent()    { return hasProfile() && role() == 'STUDENT'; }
    function isAdmin()      { return isMainAdmin() || isSubAdmin(); }
    function isAdminOrMentor() { return isAdmin() || isMentor(); }

    // ========== 1. USER PROFILES ==========
    // This collection stores each user's role, collegeId, and internal userId.
    // It's used by all other rules to determine access.
    //
    // Any authenticated user can CREATE their own profile (first-time setup after login).
    // Users can READ their own profile. Admins and mentors can READ all profiles.
    // Users can UPDATE their own profile. Main admin can UPDATE any.
    match /userProfiles/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (
        request.auth.uid == uid || (hasProfile() && isAdminOrMentor())
      );
      allow update: if request.auth != null && (
        request.auth.uid == uid || isMainAdmin()
      );
      allow delete: if isMainAdmin();
    }

    // ========== 2. LEADERBOARD ==========
    // All authenticated users can READ the leaderboard (it's a public ranking).
    // Users can WRITE only their own entry (matched by internal userId).
    // Admins/mentors can delete any entry (for cleanup when an account is removed).
    // A user can also delete their own entry (self-cleanup on account deletion).
    match /leaderboard/{userId} {
      allow read: if hasProfile();
      allow create, update: if hasProfile() && (
        userId == dbUserId() || isMainAdmin()
      );
      allow delete: if hasProfile() && (
        userId == dbUserId() || isAdminOrMentor()
      );
    }

    // ========== 3. ACTIVITY FEED ==========
    // Main admin: can read ALL activities.
    // Sub-admin: can read activities from their college only.
    // Mentor: can read activities from their college only.
    // Student: can read their OWN activities only.
    // Any authenticated user can CREATE an activity (their own).
    // Admins can UPDATE activities. Admins, mentors, and the entry owner
    // can DELETE (so a user's activity feed is cleaned up when their account
    // is removed by an admin/mentor OR self-deleted).
    match /activityFeed/{activityId} {
      allow read: if hasProfile() && (
        isMainAdmin() ||
        (isAdminOrMentor() && resource.data.collegeId == collegeId()) ||
        (isStudent() && resource.data.userId == dbUserId())
      );
      allow create: if hasProfile();
      allow update: if isAdmin();
      allow delete: if hasProfile() && (
        resource.data.userId == dbUserId() || isAdminOrMentor()
      );
    }

    // ========== 4. DISCUSSION FORUM ==========
    // All authenticated users can READ topics and posts.
    // Any authenticated user can CREATE topics and posts.
    // Users can UPDATE/DELETE their own topics/posts. Admins can delete any.
    match /forum_topics/{topicId} {
      allow read: if hasProfile();
      allow create: if hasProfile();
      allow update, delete: if hasProfile() && (
        resource.data.authorId == dbUserId() || isAdmin()
      );

      // Posts (replies) within topics
      match /posts/{postId} {
        allow read: if hasProfile();
        allow create: if hasProfile();
        allow update, delete: if hasProfile() && (
          resource.data.authorId == dbUserId() || isAdmin()
        );
      }
    }

    // ========== 5. STUDENT NOTES & BOOKMARKS ==========
    // Only the owner can READ, CREATE, or UPDATE their notes.
    // Admins/mentors can DELETE notes (for cleanup when an account is removed).
    // The owner can also DELETE their own notes (self-cleanup on account deletion).
    // The path is: notes/{userId}/items/{noteId}
    // userId here is the internal DB userId (not Firebase UID).
    match /notes/{userId}/items/{noteId} {
      allow read, create, update: if hasProfile() && userId == dbUserId();
      allow delete: if hasProfile() && (
        userId == dbUserId() || isAdminOrMentor()
      );
    }

    // ========== 6. ANNOUNCEMENTS ==========
    // All authenticated users can READ announcements.
    // Only admins (main + sub) can CREATE, UPDATE, or DELETE announcements.
    // Sub-admins can only manage announcements for their own college
    // (enforced by checking targetCollegeId in the document).
    match /announcements/{announcementId} {
      allow read: if hasProfile();
      allow create: if isAdmin() && (
        isMainAdmin() ||
        (isSubAdmin() && request.resource.data.targetCollegeId == collegeId())
      );
      allow update, delete: if isAdmin() && (
        isMainAdmin() ||
        (isSubAdmin() && resource.data.targetCollegeId == collegeId())
      );
    }

    // ========== 7. LIVE MOCK TEST RANKINGS ==========
    // All authenticated users can READ rankings (to see who's taking the test).
    // Users can WRITE only their own ranking entry.
    // Admins can write any. Admins, mentors, and the entry owner can delete
    // (for cleanup when an account is removed).
    match /mockRankings/{rankingId} {
      allow read: if hasProfile();
      allow create, update: if hasProfile() && (
        request.resource.data.userId == dbUserId() || isAdmin()
      );
      allow delete: if hasProfile() && (
        resource.data.userId == dbUserId() || isAdminOrMentor()
      );
    }

    // ========== DEFAULT DENY ==========
    // Any collection not explicitly matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
